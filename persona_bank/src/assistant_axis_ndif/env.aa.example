# Assistant Axis / NDIF pipeline -- copy to  src/assistant_axis_ndif/.env  and fill in.
# Read by 1_generate_ndif.py, 3_judge_ndif.py, 2_activations_ndif.py, run_pipeline.py.
# This file is gitignored -- your keys never leave this machine.

# NDIF API key -- get one (free) at https://login.ndif.us
NDIF_API_KEY=

# NDIF API host. Leave as-is (nnsight 0.7 ships a scheme-less default that is rejected).
NDIF_HOST=https://api.ndif.us

# Hugging Face token (read scope) -- used ONLY to download the gated tokenizer + config
# to this machine (~20 MB). The model weights run on NDIF, never here.
# First accept the licenses (same HF account as the token) at:
#   https://huggingface.co/meta-llama/Llama-3.3-70B-Instruct   (subject model)
#   https://huggingface.co/meta-llama/Llama-3.1-70B-Instruct   (judge model)
HF_TOKEN=

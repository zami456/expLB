+def parse_question_ids(spec: str | None) -> set[int] | None:
+    """'0-9,30-59' or '@file.json' (a JSON list of ints) -> set of question indices; None = all."""
+    if not spec:
+        return None
+    spec = spec.strip()
+    if spec.startswith("@"):
+        return {int(x) for x in json.loads(Path(spec[1:]).read_text(encoding="utf-8"))}
+    out: set[int] = set()
+    for part in spec.split(","):
+        part = part.strip()
+        if not part:
+            continue
+        if "-" in part:
+            a, b = part.split("-", 1)
+            out.update(range(int(a), int(b) + 1))
+        else:
+            out.add(int(part))
+    return out
+
+
+def _run_session_multi(llm, layer_idx, hidden, prepared, retries):
+    """One NDIF job over many batches, returning each batch's (K,H) sum separately.
+
+    Same server-side body as `_run_session`; the difference is that every batch keeps its
+    own saved tensor instead of adding into one accumulator, so a session of B batches
+    downloads B x K x H floats (2.6 MB for 20 batches x 4 layers x 8192). The per-batch
+    count is the number of rows, known on the client, so nothing else comes back.
+    """
+    vl = is_vision_language(llm)
+    n_batches = len(prepared)
+    delay = 3.0
+    for attempt in range(retries):
+        try:
+            # nnsight 0.7 executes the body of the session block remotely, so only names assigned
+            # inside the block and .save()d come back (a list appended to from inside the block
+            # stays empty on the client). One saved (B,K,H) accumulator, one row per batch, as
+            # `_run_session` keeps one (K,H) sum.
+            with llm.session(remote=True):
+                acc = torch.zeros(n_batches, len(layer_idx), hidden, dtype=torch.float32).save()
+                for i, (input_ids, attn, span) in enumerate(prepared):
+                    with llm.trace({"input_ids": input_ids, "attention_mask": attn}):
+                        acc[i] += _span_mean_sum(llm, layer_idx, span, vl).cpu()
+            a = getattr(acc, "value", acc)
+            if tuple(a.shape) != (n_batches, len(layer_idx), hidden):
+                raise RuntimeError(f"session returned shape {tuple(a.shape)} for {n_batches} batches")
+            if not torch.isfinite(a).all():
+                raise RuntimeError("session returned non-finite values")
+            if float(a.abs().sum()) == 0:
+                raise RuntimeError("session returned all zeros (server-side accumulation did not take "
+                                   "effect -- try --accum client)")
+            return [a[i].clone() for i in range(n_batches)]
+        except Exception as e:  # noqa: BLE001 -- engineio b'P' / ConnectionError / NDIF hiccup
+            _lines = [ln for ln in str(e).strip().splitlines() if ln.strip()]
+            _tail = (_lines[-1].strip() if _lines else repr(e))[:400]
+            logger.warning("  session attempt %d/%d failed: %s: %s",
+                           attempt + 1, retries, type(e).__name__, _tail)
+            time.sleep(delay)
+            delay = min(delay * 2, 60)
+    return None
+

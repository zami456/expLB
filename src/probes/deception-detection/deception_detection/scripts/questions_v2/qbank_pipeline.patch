+def _ndif_ws_reachable(timeout: float = 10.0) -> bool:
+    """Is NDIF's websocket endpoint accepting connections? nnsight 0.8 / NDIF 0.8 subscribe at wss://<host>/subscribe
+    (a plain HTTP upgrade answers 101); nnsight 0.7 used socket.io at /ws/socket.io (polling handshake answers
+    200). Both are probed with the standard library so the check needs no client package. During the NDIF 0.8
+    upgrade (2026-10-16 22:27 to 2026-10-17 02:00) /status and /ping kept answering while every job submission
+    failed, so the status endpoint alone cannot tell when a retry is worth sending."""
+    import http.client
+    from urllib.parse import urlparse
+
+    host = os.environ.get("NDIF_HOST") or "https://api.ndif.us"
+    try:
+        from nnsight import CONFIG
+
+        host = getattr(CONFIG.API, "HOST", host) or host
+    except Exception:  # noqa: BLE001
+        pass
+    u = urlparse(host)
+    conn_cls = http.client.HTTPSConnection if u.scheme == "https" else http.client.HTTPConnection
+    for path, headers, ok in (
+        ("/subscribe", {"Connection": "Upgrade", "Upgrade": "websocket", "Sec-WebSocket-Version": "13",
+                        "Sec-WebSocket-Key": "dGhlIHNhbXBsZSBub25jZQ=="}, (101,)),
+        ("/ws/socket.io/?EIO=4&transport=polling", {}, (200,)),
+    ):
+        try:
+            c = conn_cls(u.netloc, timeout=timeout)
+            c.request("GET", path, headers=headers)
+            status = c.getresponse().status
+            c.close()
+            if status in ok:
+                return True
+        except Exception:  # noqa: BLE001
+            continue
+    return False

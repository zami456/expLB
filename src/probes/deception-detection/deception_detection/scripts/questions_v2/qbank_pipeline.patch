+def extract_per_question(llm, layer_idx, hidden, encoder, role: str, kept: list[tuple[list[dict], int]],
+                         q_present: list[int], vtype: str, keep: set[int], args, pad_id: int) -> None:
+    """One mean vector per (role, question): <output_dir>/<role>/q{qid:03d}.pt, or q{qid:03d}.empty
+    when no row of that question was kept. Every question in `q_present` (the questions the role
+    answered) gets one of the two. Resumable per file. A failed session writes nothing for its
+    questions (the next run retries them), so a saved cell always averages every kept row."""
+    role_dir = Path(args.output_dir) / role
+    role_dir.mkdir(parents=True, exist_ok=True)
+    by_q: dict[int, list[list[dict]]] = {}
+    for conv, qi in kept:
+        by_q.setdefault(int(qi), []).append(conv)
+    all_q = sorted(set(int(q) for q in q_present) | set(by_q))
+    todo = [q for q in all_q if not (role_dir / f"q{q:03d}.pt").exists() and not (role_dir / f"q{q:03d}.empty").exists()]
+    if not todo:
+        logger.info("Role %s: per-question store complete (%d cells)", role, len(all_q)); return
+
+    # batches: one question per batch (<= 5 rows), split only if the token budget forces it
+    groups: list[tuple[int, list]] = []  # (qid, padded batch)
+    empties = 0
+    n_in = 0

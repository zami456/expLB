+logging.basicConfig(level=logging.INFO, format="%(asctime)s - %(levelname)s - %(message)s")
+logger = logging.getLogger("2_activations_ndif")
+
+
+def key(pi: int, qi: int) -> str:
+    return f"pos_p{pi}_q{qi}"

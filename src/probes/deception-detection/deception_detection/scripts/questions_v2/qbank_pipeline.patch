+    for q in todo:
+        convs = by_q.get(q, [])
+        if not convs:
+            (role_dir / f"q{q:03d}.empty").write_bytes(b""); empties += 1
+            continue
+        n_in += len(convs)
+        drops: Counter = Counter()
+        items = build_items(encoder, convs, args.max_length, drops)
+        drops_all.update(drops)
+        if not items:
+            (role_dir / f"q{q:03d}.empty").write_bytes(b""); empties += 1
+            continue
+        for b in batch_by_tokens(items, args.token_budget, args.batch_size):
+            groups.append((q, pad_batch(b, pad_id)))
+    if drops_all:
+        report_drops(drops_all, n_in, n_in - sum(v for k, v in drops_all.items() if k != "truncated_context"), f"{role}: ")
+    if empties:
+        logger.info("Role %s: %d question(s) with no kept row -> .empty", role, empties)
+    if not groups:
+        return
+    widest = max(int(b[0].shape[0] * b[0].shape[1]) for _, b in groups)
+    logger.info("Role %s: %d question batches for %d questions (widest %d padded tokens, budget %d)",
+                role, len(groups), len(set(q for q, _ in groups)), widest, args.token_budget)
+
+    # sessions never split a question's batches
+    sessions: list[list[tuple[int, tuple]]] = []
+    cur: list[tuple[int, tuple]] = []
+    i = 0
+    while i < len(groups):
+        q = groups[i][0]
+        same = [g for g in groups[i:] if g[0] == q]
+        if cur and len(cur) + len(same) > args.session_batches:
+            sessions.append(cur); cur = []
+        cur.extend(same)
+        i += len(same)
+    if cur:
+        sessions.append(cur)
+
+    written = 0
+    for sess in tqdm(sessions, desc="  ndif sessions", leave=False):
+        prepared = [b for _, b in sess]
+        if args.accum == "session":
+            vals = _run_session_multi(llm, layer_idx, hidden, prepared, args.retries)
+        else:
+            vals = []
+            for input_ids, attn, span in prepared:
+                got = _run_batch_client(llm, layer_idx, input_ids, attn, span, args.retries)
+                if got is None:
+                    vals = None; break
+                vals.append(got[0])
+        if vals is None:
+            logger.error("Role %s: session of %d batches failed; its %d question(s) are left for a resume",
+                         role, len(prepared), len(set(q for q, _ in sess)))
+            continue
+        sums: dict[int, torch.Tensor] = {}
+        counts: dict[int, int] = {}
+        for (q, (input_ids, _, span)), v in zip(sess, vals):
+            sums[q] = sums.get(q, torch.zeros(len(layer_idx), hidden, dtype=torch.float64)) + v.to(torch.float64)
+            counts[q] = counts.get(q, 0) + int(span.shape[0])
+        for q in sums:
+            vec = (sums[q] / counts[q]).to(torch.float32)
+            torch.save({"vector": vec, "layers": list(layer_idx), "type": vtype, "role": role,
+                        "n": int(counts[q]), "question_index": int(q), "keep_scores": sorted(keep)},
+                       role_dir / f"q{q:03d}.pt")
+            written += 1

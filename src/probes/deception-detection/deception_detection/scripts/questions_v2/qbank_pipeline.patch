+def _ndif_model_running(repo_id: str) -> bool | None:
+    """True when api.ndif.us/status lists a RUNNING replica of `repo_id`, False when it lists none, None when the
+    status call itself failed. Added 2026-10-17 after a multi-hour NDIF outage (every Llama-3.3-70B replica
+    UNHEALTHY from 22:27): without it a session gives up after --retries and the shard walks through all its
+    roles dropping every session, so the chain's generation attempts burn while nothing can be generated."""
+    import json
+    import urllib.request
+
+    try:
+        with urllib.request.urlopen("https://api.ndif.us/status", timeout=30) as r:
+            d = json.loads(r.read().decode("utf-8"))
+    except Exception:  # noqa: BLE001
+        return None
+    deployments = d.get("deployments") or {}
+    values = deployments.values() if isinstance(deployments, dict) else deployments
+    for v in values:
+        if isinstance(v, dict) and v.get("repo_id") == repo_id and v.get("application_state") == "RUNNING":
+            return True
+    return False
+
+
+def _looks_like_outage(exc_name: str, tail: str) -> bool:
+    s = f"{exc_name} {tail}".lower()
+    return any(k in s for k in ("connect", "disconnect", "timeout", "timed out", "evicted", "unavailable",
+                                "bad gateway", "502", "503", "504"))
+
+
+def _ndif_ws_reachable(timeout: float = 10.0) -> bool:
+    """Can a socket.io client open NDIF's websocket? That is the first step of nnsight's blocking_request
+    (remote.py: sio.connect(ws_address, socketio_path="/ws/socket.io", transports=["websocket"])), and it was
+    the step failing for hours on 2026-10-17 (the NDIF 0.8 upgrade day) while /status and /ping still answered
+    and a replica showed RUNNING, so the status endpoint alone cannot tell when a retry is worth sending."""
+    try:
+        import socketio
+        from nnsight import CONFIG
+
+        host = CONFIG.API.HOST
+        ws = ("wss://" + host[8:]) if host.startswith("https://") else ("ws://" + host[7:])
+        with socketio.SimpleClient(reconnection_attempts=1) as sio:
+            sio.connect(ws, socketio_path="/ws/socket.io", transports=["websocket"], wait_timeout=timeout)
+        return True
+    except Exception:  # noqa: BLE001
+        return False
+
+
+def _wait_out_outage(repo_id: str, started: float, cap_s: float, cycle: int, poll_s: float = 60.0) -> bool:
+    """Block until the status endpoint shows a RUNNING replica of the model AND the websocket accepts a
+    connection, then settle (2 min, doubling per cycle up to 10 min) before the caller retries; False once the
+    outage cap is reached."""
+    polls = 0
+    while True:
+        if time.time() - started > cap_s:
+            return False
+        state = _ndif_model_running(repo_id)
+        ws_ok = _ndif_ws_reachable() if state is True else False
+        if state is True and ws_ok:
+            settle = min(120.0 * (2 ** cycle), 600.0)
+            logger.warning("  NDIF outage: %s has a RUNNING replica and the websocket answers; settling %.0f s "
+                           "before retrying (outage %.0f min so far)", repo_id, settle, (time.time() - started) / 60)
+            time.sleep(settle)
+            return True
+        if polls % 5 == 0:
+            what = ("status endpoint unreachable" if state is None else
+                    "no RUNNING replica" if state is False else "replica RUNNING but the websocket refuses connections")
+            logger.warning("  NDIF outage: %s: %s; waiting (%.0f min so far, cap %.0f min)", repo_id, what,
+                           (time.time() - started) / 60, cap_s / 60)
+        polls += 1
+        time.sleep(poll_s)
+

# Assistant Axis / NDIF pipeline -- copy to  assistant_axis/pipeline/.env  and fill in.
# This file is read by 1_generate_ndif.py, 3_judge_ndif.py, 2_activations_ndif.py.

# NDIF API key -- get one at https://login.ndif.us
NDIF_API_KEY=

# NDIF API host. Leave as-is (nnsight 0.7 ships a broken default).
NDIF_HOST=https://api.ndif.us

# Hugging Face token (read scope) -- used ONLY to download the gated
# Llama-3.3-70B / Qwen2.5-72B tokenizer + config to this machine (~20 MB total).
# The model weights run on NDIF, never here.
# First accept the license at:
#   https://huggingface.co/meta-llama/Llama-3.3-70B-Instruct
HF_TOKEN=
